# Copy to deploy/.env and fill in real values before running docker compose.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-generate-a-real-64-byte-hex-secret

# Your web-controller's public origin(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://remote.your-domain.example.com

# STUN + your own TURN server. Replace the TURN username/credential with the
# ones you set in coturn/turnserver.conf (static-auth-secret mode is more
# secure for production - see that file's comments).
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-vps-domain.example.com:3478","username":"turnuser","credential":"changeme-turn-password"}]
