# Copy to .env and fill in real values before running in production.

# Port the HTTP + WebSocket server listens on
PORT=8443

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-generate-a-real-64-byte-hex-secret

# Path to the SQLite database file
DB_PATH=./data/remote-desktop.db

# Comma-separated list of origins allowed to call the REST API / connect the WS
# (your web-controller origin(s), e.g. https://remote.example.com)
ALLOWED_ORIGINS=http://localhost:5173

# Pairing code lifetime, in seconds
PAIRING_CODE_TTL_SECONDS=180

# Max failed pairing attempts allowed per device within the lockout window
PAIRING_MAX_ATTEMPTS=5
PAIRING_LOCKOUT_WINDOW_SECONDS=300

# STUN/TURN servers handed to controllers and hosts for ICE (JSON array string)
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-vps-domain:3478","username":"turnuser","credential":"turnpassword"}]
