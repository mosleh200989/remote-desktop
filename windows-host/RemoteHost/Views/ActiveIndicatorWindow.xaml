<Window x:Class="RemoteHost.Views.ActiveIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote control active"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="#D92D20" Height="40">
    <DockPanel Margin="16,0" LastChildFill="True">
        <Button x:Name="EndButton" DockPanel.Dock="Right" Content="End session" Click="EndButton_Click"
                Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="MessageText" Foreground="White" FontWeight="Bold" FontSize="14"
                   VerticalAlignment="Center" Text="Remote control is active"/>
    </DockPanel>
</Window>
