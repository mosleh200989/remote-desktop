<Window x:Class="RemoteHost.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop Host" Height="620" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="Connecting..." VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Device ID" FontWeight="Bold"/>
                <TextBlock x:Name="DeviceIdText" Text="—" FontSize="22" FontFamily="Consolas" Margin="0,4,0,10"/>

                <TextBlock Text="Pairing code (share this with the controller)" FontWeight="Bold"/>
                <TextBlock x:Name="PairingCodeText" Text="—" FontSize="28" FontFamily="Consolas" Margin="0,4,0,2"/>
                <TextBlock x:Name="PairingExpiryText" Text="" Foreground="Gray" Margin="0,0,0,8"/>
                <Button x:Name="NewCodeButton" Content="Generate new code" Click="NewCodeButton_Click" HorizontalAlignment="Left" Padding="8,4"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Monitor to share" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel x:Name="PendingRequestsPanel">
                <TextBlock Text="Connection requests" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoPendingText" Text="No pending requests." Foreground="Gray"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" x:Name="ActiveSessionBorder" Background="#FFF3CD" BorderBrush="#E0A800" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Remote control is ACTIVE" FontWeight="Bold" Foreground="#7A5B00"/>
                <TextBlock x:Name="ActiveSessionText" Text="" Margin="0,4,0,8"/>
                <Button x:Name="EndSessionButton" Content="End session now" Click="EndSessionButton_Click" HorizontalAlignment="Left" Padding="8,4" Background="#D92D20" Foreground="White"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="8">
            <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas" FontSize="11"/>
        </Border>
    </Grid>
</Window>
