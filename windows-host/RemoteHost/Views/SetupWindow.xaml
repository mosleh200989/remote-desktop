<Window x:Class="RemoteHost.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop Host - Setup" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Set up this computer as a host" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="Connects this PC to your signaling server so it can be paired and controlled." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>

        <TextBlock Text="Signaling server URL"/>
        <TextBox x:Name="ServerUrlBox" Text="https://your-vps-domain.example.com" Margin="0,2,0,12"/>

        <TextBlock Text="Device name (shown to you only)"/>
        <TextBox x:Name="DeviceNameBox" Text="My Desktop" Margin="0,2,0,12"/>

        <TextBlock Text="Email"/>
        <TextBox x:Name="EmailBox" Margin="0,2,0,12"/>

        <TextBlock Text="Password"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,12"/>

        <CheckBox x:Name="RegisterCheckBox" Content="I don't have an account yet (register)" Margin="0,0,0,16"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <Button x:Name="SubmitButton" Content="Connect this computer" Height="34" Click="SubmitButton_Click"/>
        <TextBlock x:Name="BusyText" Text="Working..." Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
