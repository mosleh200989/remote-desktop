<Window x:Class="RemoteHost.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop - Setup" Height="400" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Set up this computer" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="No account needed - just point this at your signaling server. You'll get a device ID and pairing code to share, and can also connect out to another computer from here." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>

        <TextBlock Text="Signaling server URL"/>
        <TextBox x:Name="ServerUrlBox" Text="https://your-vps-domain.example.com" Margin="0,2,0,12"/>

        <TextBlock Text="This computer's name (shown to you only)"/>
        <TextBox x:Name="DeviceNameBox" Text="My Desktop" Margin="0,2,0,12"/>

        <TextBlock Text="Your name (shown to hosts when you connect out to them)"/>
        <TextBox x:Name="DisplayNameBox" Margin="0,2,0,16"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <Button x:Name="SubmitButton" Content="Continue" Height="34" Click="SubmitButton_Click"/>
        <TextBlock x:Name="BusyText" Text="Working..." Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
