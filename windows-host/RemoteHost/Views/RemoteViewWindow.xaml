<Window x:Class="RemoteHost.Views.RemoteViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop" Height="720" Width="1280"
        Background="Black" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#111" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Files" Margin="4" Padding="10,4" Click="FilesButton_Click"/>
            <Button Grid.Column="2" Content="End session" Margin="4,4,12,4" Padding="10,4" Background="#D92D20" Foreground="White" Click="EndSessionButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True"
                   MouseMove="RemoteImage_MouseMove"
                   MouseDown="RemoteImage_MouseDown"
                   MouseUp="RemoteImage_MouseUp"
                   MouseWheel="RemoteImage_MouseWheel"/>
            <Border x:Name="FilesPanelHost" Width="320" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="10"
                    Padding="14" Visibility="Collapsed" MaxHeight="600">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Files" FontWeight="Bold" Foreground="White"/>
                            <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CloseFilesButton_Click"/>
                        </DockPanel>
                        <Button x:Name="SendFileButton" Content="Send a file..." Padding="8,4" Margin="0,0,0,10" Click="SendFileButton_Click"/>
                        <StackPanel x:Name="FileTransfersPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
